{
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "cookie",
          "key": "suku_lang",
          "value": "de"
        }
      ],
      "destination": "/de/index.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "cookie",
          "key": "suku_lang",
          "value": "en"
        }
      ],
      "destination": "/en/index.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "accept-language",
          "value": "(?i)^de.*"
        }
      ],
      "destination": "/de/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/en/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Vary",
          "value": "Accept-Language, Cookie"
        }
      ]
    },
    {
      "source": "/(fonts|img)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
